// JDL - Modèle de gestion de projets (type Jira)
// Généré à partir du diagramme de classe fourni
// Remarque : l'entité User est l'entité "User" native de JHipster
// (login, firstName, lastName, email, password sont déjà gérés par JHipster).
// Elle n'est donc pas redéfinie ici, seulement référencée dans les relations.
//
// Les rôles globaux (admin, chef de projet, développeur, ...) sont gérés par
// l'entité "Authority" native de JHipster (jhi_authority / jhi_user_authority),
// au même titre que "User" : ni l'une ni l'autre n'est redéfinie ici.
// Les rôles au niveau d'un projet (propriétaire / manager / membre) sont portés
// par ProjectMember.role (voir enum ProjectRole ci-dessous).
// =========================================================

entity Project {
  name String required,
  description String,
  projectKey String required,
  createdAt Instant
}

entity ProjectMember {
  role ProjectRole required,
  joinedAt Instant required
}

entity Sprint {
  name String required,
  goal String,
  startDate LocalDate,
  endDate LocalDate,
  status SprintStatus
}

entity Epic {
  title String required,
  description String,
  status EpicStatus,
  priority Priority,
  createdAt Instant,
  updatedAt Instant,
  startDate LocalDate,
  endDate LocalDate
}

entity Task {
  title String required,
  description String,
  status TaskStatus,
  priority Priority,
  storyPoints Integer,
  createdAt Instant,
  updatedAt Instant
}

entity Comment {
  content String required,
  createdAt Instant
}

entity Attachment {
  fileName String required,
  filePath String required,
  uploadedAt Instant
}

entity Notification {
  message String required,
  taskTitle String,
  isRead Boolean,
  createdAt Instant
}

entity TaskHistory {
  action String required maxlength(100),
  oldValue String maxlength(500),
  newValue String maxlength(500),
  createdAt Instant required
}

// =========================================================
// Enumérations
// =========================================================

enum SprintStatus {
  PLANNED, ACTIVE, COMPLETED, CANCELLED
}

enum EpicStatus {
  TODO, IN_PROGRESS, DONE, CANCELLED
}

enum TaskStatus {
  NEW, IN_PROGRESS, READY_FOR_TEST, DONE, NEEDS_INFO
}

enum Priority {
  LOWEST, LOW, MEDIUM, HIGH, HIGHEST
}

enum ProjectRole {
  OWNER, MANAGER, MEMBER
}

// =========================================================
// Relations Many-to-One vers l'entité User (native JHipster)
// =========================================================

relationship ManyToOne {
  Project{owner} to User
  Notification{user} to User
  ProjectMember{member} to User
  Task{assignee} to User
  Task{createdBy} to User
  Comment{author} to User
  TaskHistory{user} to User
}

// =========================================================
// Relations One-to-Many (avec côté inverse ManyToOne implicite)
// =========================================================

relationship OneToMany {
  Project{member} to ProjectMember{project}
  Project{sprint} to Sprint{project}
  Project{epic} to Epic{project}
  Project{task} to Task{project}
  Sprint{task} to Task{sprint}
  Epic{task} to Task{epic}
  Task{comment} to Comment{task}
  Task{attachment} to Attachment{task}
  Task{notification} to Notification{task}
  Task{history} to TaskHistory{task required}
}

// ─────────────────────────────────────────────
//  OPTIONS
// ─────────────────────────────────────────────

paginate Project, Sprint, Epic, Task, Comment, Attachment, Notification, TaskHistory with pagination
dto Project, Sprint, Epic, Task with mapstruct
service Project, ProjectMember, Sprint, Epic, Task, Comment, Attachment, Notification, TaskHistory with serviceImpl
filter Project, Sprint, Epic, Task
