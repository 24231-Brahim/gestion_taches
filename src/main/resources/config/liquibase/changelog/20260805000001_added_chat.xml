<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog-ext.xsd">

    <changeSet id="20260805000001-1" author="gestiontaches">
        <createTable tableName="chat_conversation">
            <column name="id" type="bigint">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_chat_conversation"/>
            </column>
            <column name="type" type="varchar(20)">
                <constraints nullable="false" />
            </column>
            <column name="name" type="varchar(100)"/>
            <column name="project_id" type="bigint">
                <constraints nullable="false" />
            </column>
            <column name="created_by" type="bigint"/>
            <column name="created_at" type="${datetimeType}">
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>

    <changeSet id="20260805000001-2" author="gestiontaches">
        <createTable tableName="chat_conversation_member">
            <column name="id" type="bigint">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_chat_conversation_member"/>
            </column>
            <column name="conversation_id" type="bigint">
                <constraints nullable="false" />
            </column>
            <column name="user_id" type="bigint">
                <constraints nullable="false" />
            </column>
            <column name="joined_at" type="${datetimeType}">
                <constraints nullable="false" />
            </column>
            <column name="last_read_at" type="${datetimeType}"/>
        </createTable>
        <addUniqueConstraint columnNames="conversation_id, user_id"
                             constraintName="ux_chat_conversation_member__conversation_user"
                             tableName="chat_conversation_member"/>
    </changeSet>

    <changeSet id="20260805000001-3" author="gestiontaches">
        <createTable tableName="chat_message">
            <column name="id" type="bigint">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_chat_message"/>
            </column>
            <column name="content" type="varchar(5000)">
                <constraints nullable="false" />
            </column>
            <column name="conversation_id" type="bigint">
                <constraints nullable="false" />
            </column>
            <column name="sender_id" type="bigint">
                <constraints nullable="false" />
            </column>
            <column name="parent_message_id" type="bigint"/>
            <column name="created_at" type="${datetimeType}">
                <constraints nullable="false" />
            </column>
            <column name="edited_at" type="${datetimeType}"/>
            <column name="deleted" type="boolean">
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>

    <changeSet id="20260805000001-4" author="gestiontaches">
        <createTable tableName="chat_message_mentions">
            <column name="message_id" type="bigint">
                <constraints nullable="false" />
            </column>
            <column name="user_id" type="bigint">
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>

    <changeSet id="20260805000001-5" author="gestiontaches">
        <createTable tableName="chat_message_reaction">
            <column name="id" type="bigint">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_chat_message_reaction"/>
            </column>
            <column name="message_id" type="bigint">
                <constraints nullable="false" />
            </column>
            <column name="user_id" type="bigint">
                <constraints nullable="false" />
            </column>
            <column name="emoji" type="varchar(16)">
                <constraints nullable="false" />
            </column>
            <column name="created_at" type="${datetimeType}">
                <constraints nullable="false" />
            </column>
        </createTable>
        <addUniqueConstraint columnNames="message_id, user_id, emoji"
                             constraintName="ux_chat_message_reaction__message_user_emoji"
                             tableName="chat_message_reaction"/>
    </changeSet>

    <changeSet id="20260805000001-6" author="gestiontaches">
        <createTable tableName="chat_attachment">
            <column name="id" type="bigint">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_chat_attachment"/>
            </column>
            <column name="message_id" type="bigint">
                <constraints nullable="false" />
            </column>
            <column name="file_name" type="varchar(255)"/>
            <column name="file_type" type="varchar(100)"/>
            <column name="file_size" type="bigint"/>
            <column name="file_path" type="varchar(500)"/>
            <column name="uploaded_by" type="bigint"/>
            <column name="uploaded_at" type="${datetimeType}">
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>

    <changeSet id="20260805000001-7" author="gestiontaches">
        <createTable tableName="chat_user_presence">
            <column name="id" type="bigint">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_chat_user_presence"/>
            </column>
            <column name="user_id" type="bigint">
                <constraints nullable="false" />
            </column>
            <column name="last_active_at" type="${datetimeType}">
                <constraints nullable="false" />
            </column>
        </createTable>
        <addUniqueConstraint columnNames="user_id"
                             constraintName="ux_chat_user_presence__user"
                             tableName="chat_user_presence"/>
    </changeSet>

    <changeSet id="20260805000001-8" author="gestiontaches">
        <addForeignKeyConstraint baseColumnNames="project_id"
                                 baseTableName="chat_conversation"
                                 constraintName="fk_chat_conversation__project_id"
                                 referencedColumnNames="id"
                                 referencedTableName="project"
                                 />
        <addForeignKeyConstraint baseColumnNames="created_by"
                                 baseTableName="chat_conversation"
                                 constraintName="fk_chat_conversation__created_by"
                                 referencedColumnNames="id"
                                 referencedTableName="jhi_user"
                                 />
        <addForeignKeyConstraint baseColumnNames="conversation_id"
                                 baseTableName="chat_conversation_member"
                                 constraintName="fk_chat_conversation_member__conversation_id"
                                 referencedColumnNames="id"
                                 referencedTableName="chat_conversation"
                                 />
        <addForeignKeyConstraint baseColumnNames="user_id"
                                 baseTableName="chat_conversation_member"
                                 constraintName="fk_chat_conversation_member__user_id"
                                 referencedColumnNames="id"
                                 referencedTableName="jhi_user"
                                 />
        <addForeignKeyConstraint baseColumnNames="conversation_id"
                                 baseTableName="chat_message"
                                 constraintName="fk_chat_message__conversation_id"
                                 referencedColumnNames="id"
                                 referencedTableName="chat_conversation"
                                 />
        <addForeignKeyConstraint baseColumnNames="sender_id"
                                 baseTableName="chat_message"
                                 constraintName="fk_chat_message__sender_id"
                                 referencedColumnNames="id"
                                 referencedTableName="jhi_user"
                                 />
        <addForeignKeyConstraint baseColumnNames="parent_message_id"
                                 baseTableName="chat_message"
                                 constraintName="fk_chat_message__parent_message_id"
                                 referencedColumnNames="id"
                                 referencedTableName="chat_message"
                                 />
        <addForeignKeyConstraint baseColumnNames="message_id"
                                 baseTableName="chat_message_mentions"
                                 constraintName="fk_chat_message_mentions__message_id"
                                 referencedColumnNames="id"
                                 referencedTableName="chat_message"
                                 />
        <addForeignKeyConstraint baseColumnNames="message_id"
                                 baseTableName="chat_message_reaction"
                                 constraintName="fk_chat_message_reaction__message_id"
                                 referencedColumnNames="id"
                                 referencedTableName="chat_message"
                                 />
        <addForeignKeyConstraint baseColumnNames="user_id"
                                 baseTableName="chat_message_reaction"
                                 constraintName="fk_chat_message_reaction__user_id"
                                 referencedColumnNames="id"
                                 referencedTableName="jhi_user"
                                 />
        <addForeignKeyConstraint baseColumnNames="message_id"
                                 baseTableName="chat_attachment"
                                 constraintName="fk_chat_attachment__message_id"
                                 referencedColumnNames="id"
                                 referencedTableName="chat_message"
                                 />
        <addForeignKeyConstraint baseColumnNames="uploaded_by"
                                 baseTableName="chat_attachment"
                                 constraintName="fk_chat_attachment__uploaded_by"
                                 referencedColumnNames="id"
                                 referencedTableName="jhi_user"
                                 />
        <addForeignKeyConstraint baseColumnNames="user_id"
                                 baseTableName="chat_user_presence"
                                 constraintName="fk_chat_user_presence__user_id"
                                 referencedColumnNames="id"
                                 referencedTableName="jhi_user"
                                 />
    </changeSet>

    <changeSet id="20260805000001-9" author="gestiontaches">
        <createIndex tableName="chat_message" indexName="idx_chat_message__conversation_id">
            <column name="conversation_id"/>
        </createIndex>
        <createIndex tableName="chat_conversation" indexName="idx_chat_conversation__project_id">
            <column name="project_id"/>
        </createIndex>
        <createIndex tableName="chat_conversation_member" indexName="idx_chat_conversation_member__conversation_id">
            <column name="conversation_id"/>
        </createIndex>
        <createIndex tableName="chat_message_mentions" indexName="idx_chat_message_mentions__message_id">
            <column name="message_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
